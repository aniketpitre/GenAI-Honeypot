# Copy to .env and fill in. Generate secrets with: openssl rand -hex 32
POSTGRES_PASSWORD=
ADMIN_TOKEN=            # dashboard / admin API bearer token
INTERNAL_API_KEY=       # canary-listener -> API shared secret

# Public URL canary tokens will point at (must reach canary-listener, port 8081)
CANARY_BASE_URL=http://localhost:8081

# Optional
GEMINI_API_KEY=         # AI-generated honeypot content + decoy URLs (canned fallbacks without it)
GEMINI_MODEL=gemini-2.0-flash
WEBHOOK_URL=            # Slack-compatible incoming webhook for alerts
ELASTICSEARCH_URL=      # set to http://elasticsearch:9200 when using --profile elk
HONEYPOT_SSH_PORT=2222
HONEYPOT_HTTP_PORT=8088
TRUSTED_PROXY_COUNT=0   # reverse proxies in front of canary-listener (0 = direct)
